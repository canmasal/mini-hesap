# =========================================================
# MiniHesap ortam değişkenleri
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e gönderilmez (.gitignore kapsamındadır).
# =========================================================

# --- ZORUNLU (yayına almadan önce mutlaka ayarlayın) ---

# Sitenin canlı adresi. Sonunda "/" OLMAYACAK.
# Ayarlanmazsa canonical etiketleri, sitemap.xml ve sosyal medya
# paylaşım adresleri "http://localhost:3000" olarak üretilir ve
# Google sitenizi yanlış adresle indeksler.
NEXT_PUBLIC_SITE_URL=https://alanadiniz.com


# --- ÖNERİLEN ---

# İletişim formunun mesajı ileteceği e-posta adresi.
# Boş bırakılırsa /iletisim sayfasında form yerine uyarı görünür.
NEXT_PUBLIC_CONTACT_EMAIL=iletisim@alanadiniz.com


# --- PREMIUM İNDİRME ---

# /api/premium/download uç noktasının beklediği gizli anahtar.
# Yayında mutlaka uzun ve rastgele bir değerle değiştirin.
# NOT: Bu yöntem tek ve sabit bir anahtar kullanır; anahtar bir kez
# paylaşılırsa herkes dosyayı indirebilir. Gerçek satış akışında
# satın alma başına tek kullanımlık token üretilmelidir.
PREMIUM_DOWNLOAD_SECRET=degistirin-uzun-rastgele-bir-deger


# =========================================================
# ÖDEME ALTYAPISI
# =========================================================

# Aktif ödeme sağlayıcısı. Boşsa satın alma kapalıdır ve ziyaretçiye
# "iletişime geçin" mesajı gösterilir.
#   test      -> gerçek tahsilat yapmaz, akışı uçtan uca denemek için
#   shopier   -> Shopier entegrasyonu (anahtarlar eklenince)
#   iyzico    -> iyzico entegrasyonu (anahtarlar eklenince)
PAYMENT_PROVIDER=test

# İndirme bağlantılarını imzalamak için kullanılır. EN AZ 24 KARAKTER.
# Rastgele üretin, kimseyle paylaşmayın, yayında mutlaka değiştirin.
# Örnek üretme: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_SIGNING_SECRET=en-az-24-karakterlik-rastgele-bir-deger-uretin

# Yalnızca sizin kendi testiniz ve destek talepleri için; ödeme olmadan
# indirme yapar. Tanımlamazsanız bu kapı tamamen kapalı olur.
# ADMIN_DOWNLOAD_SECRET=

# --- Sipariş kaydı ---
# Vercel gibi sunucusuz ortamlarda dosya sistemi kalıcı değildir;
# siparişleri saklamak için Supabase gerekir. Boş bırakılırsa
# siparişler private/orders.json dosyasına yazılır (yalnızca yerel).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=

# --- Shopier ---
# Shopier panelinden: Ayarlar > Uygulama / API bilgileri
# Bu anahtarlari Vercel > Settings > Environment Variables bolumune SIZ girin.
# SHOPIER_API_KEY=
# SHOPIER_API_SECRET=
# SHOPIER_WEBSITE_INDEX=1
#
# Shopier panelinde "Callback URL" olarak su adresi tanimlayin:
#   https://minihesap.net/api/odeme/bildirim
